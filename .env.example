# Copy to .env and fill in. No secret has a default: a missing one fails at
# startup rather than degrading to an insecure mode at request time.

# Postgres. Locally: eval "$(./scripts/dev-db.sh)"
DATABASE_URL=postgresql://postgres@localhost:5432/viz

# Supabase Auth JWT secret. Must be at least 32 bytes (RFC 7518 §3.2).
JWT_SECRET=

# Optional: set when the identity provider issues an audience claim.
JWT_AUDIENCE=
JWT_ALGORITHM=HS256

ENVIRONMENT=development
DB_POOL_MIN=1
DB_POOL_MAX=10
