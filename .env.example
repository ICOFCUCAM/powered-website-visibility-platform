# Copy to .env and fill in. No secret has a default: a missing one fails at
# startup rather than degrading to an insecure mode at request time.

# Postgres. Locally: eval "$(./scripts/dev-db.sh)"
DATABASE_URL=postgresql://postgres@localhost:5432/viz

# Supabase Auth JWT secret. Must be at least 32 bytes (RFC 7518 §3.2).
JWT_SECRET=

# Optional: set when the identity provider issues an audience claim.
JWT_AUDIENCE=
JWT_ALGORITHM=HS256

ENVIRONMENT=development
DB_POOL_MIN=1
DB_POOL_MAX=10

# Which browser origins may call this API, comma separated. The front end and
# the API are two origins in any real deployment, so this is configuration and
# never a constant. In production it has NO default and refuses both `*` and
# plain http: see docs/16-deployment.md.
CORS_ORIGINS=http://localhost:3000

# --- Google Hub (only required when the Hub is used) ---------------------
# From your Google Cloud project's OAuth client. Start the verification
# process before writing code: sensitive scopes take weeks to approve.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback
WEB_BASE_URL=http://localhost:3000

# Master key for the token vault. Generate with:
#   python -c "from api.hub.services.keys import generate_master_key as g; print(g())"
# In production this comes from a KMS, not from an env var.
TOKEN_MASTER_KEY=

# Cache, rate limits, temporary OAuth state, Celery broker. Pinged once when
# the API starts, so a wrong value fails the deploy rather than the first
# customer to use a feature that needs it. In production give it a password:
# on a shared container network anything else on that network can reach it.
REDIS_URL=redis://localhost:6379/0

# The API connects as app_user (RLS applies); workers and the vault connect as
# app_service (BYPASSRLS, and the only role with access to `secrets`).
SERVICE_DATABASE_URL=postgresql://app_service@localhost:5432/viz

# Owner role. Used only by migrations and the schema tests, never by the app.
ADMIN_DATABASE_URL=postgresql://postgres@localhost:5432/viz

# --- Email (weekly report, and customer alert notices) -------------------
# Without a mail server both are generated and recorded, and neither is sent:
# the row says so in `delivery_error` rather than pretending it arrived.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
REPORT_FROM_EMAIL=

# --- Alerting ------------------------------------------------------------
# Where operator alerts go. Set neither and nothing is delivered — which is
# logged loudly rather than assumed handled, and every open incident is
# announced the day a destination appears.
# The webhook payload is Slack-compatible (Slack, Mattermost, Discord's Slack
# endpoint, most generic receivers). No customer domain is ever sent to it.
ALERT_WEBHOOK_URL=
# Comma separated. Requires the SMTP settings above.
ALERT_EMAIL=

# --- Background schedule --------------------------------------------------
# Seconds between dispatcher ticks and between alert scans. Development only;
# production leaves both alone.
SCHEDULER_TICK_SECONDS=300
ALERT_SCAN_SECONDS=900

# --- The public scan (docs/17-public-scan.md) ----------------------------
# The hero's live check is rate limited in Redis and FAILS CLOSED: with no
# REDIS_URL it refuses rather than running uncounted, because an endpoint that
# fetches arbitrary URLs is not something to leave unmetered. It needs no
# settings of its own — the limits are constants in api/peek/limits.py, where
# changing them is a reviewed decision rather than an environment variable.
